PROC(setValidateIndex)
//*******************************************************************************
// Set Validation Index
//*******************************************************************************
//-------------------------------------------------------------------------------
copy(setValidateIndex_Resu,"oui")
//
setin(FicIndex,"eclatement.tab",RepTravail"/"_currentVpfInd)
// Test d'erreur d'ouverture du fichier
gosub(GenGetErreur)
if(OutGetErreur_Erreur!="")
   {
      copy(InTraceExec_TypeMessage,"E")
      copy(InTraceExec_Message,"Erreur d'ouverture du fichier d'index : "RepTravail"/"_currentVpfInd)
      copy(InTraceExec_Needed,"oui")
      gosub(GenTraceExec)
      copy(FlagArret,"oui")
      copy(setValidateIndex_Resu,"non")
      EXITPROC
   }
oneof(FicIndex,"- SET EOF VAR -")
//lecture ligne d'entete
read(FicIndex,"entete")
//lecture 1 er document
read(FicIndex,"theader")
read(FicIndex,"ligne")
read(FicIndex,"fonction")
read(FicIndex,"calcul")
//
gosub(set_Mail_Fax_Info)
//
calc(nbpage=0)
// Boucle sur chaque fichier trouve (chaque ligne d'index)
while(FicIndex_eof==0)
   {
      calc(nbpage=nbpage+FicIndex.ligne.NbFeuillet)
      //Lecture doc suivant
      read(FicIndex,"theader")
      read(FicIndex,"ligne")
      read(FicIndex,"fonction")
      read(FicIndex,"calcul")
   }
calc(NbPageGED=nbpage)
//fermeture du fichier
setin(FicIndex,"eclatement.tab","- NO IN -")
//
copy(pdffname,_currentPdf)
//
copy(xmlfname,_currentXml)
//
//Ecriture du Fichier d'indexation GED
// Ouverture / écriture du fichier XML de sortie (InIdTrt_RefGED.xml)
call(HeureCourante,LB_GetTime,"")
//Calcul Date et heure
call(DateCourante,LB_GetDate,"")
//
copy(pyGSFileSize_InFile,RepTravail"/"_currentPdf)
gosub(pyGSFileSize)
if(pyGSFileSize_Resu!="oui")
   {
      EXITPROC
   }
copy(pdfFileSize,pyGSFileSize_OutSize)
copy(BufferXmlVal,TxtControleVal)
setout(FicXmlVal,RepTravail"/"_currentXmlInd)
//Détection erreur d'ouverture du fichier
gosub(GenGetErreur)
if(OutGetErreur_Erreur!="")
   {
      copy(InTraceExec_TypeMessage,"E")
      copy(InTraceExec_Message,"Erreur d'ouverture en sortie du fichier : "RepTravail"/"_currentXmlInd)
      gosub(GenTraceExec)
      copy(FlagArret,"oui")
      copy(setValidateIndex_Resu,"non")
      setout(FicXmlVal,"- NO OUT -")
      EXITPROC
   }
write(FicXmlVal,BufferXmlVal)
setout(FicXmlVal,"- NO OUT -")
ENDPROC
