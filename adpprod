      //
      copy(getAxNbF_TopPage,FicIndex.ligne.AttachedTop)
      if(getAxNbF_TopPage=="")
         {
            itread(getAxNbF_TopPage,TabEdoc,"2",FicIndex.ligne.CodeModele)
            if(getAxNbF_TopPage=="undefined")
               {
                  copy(getAxNbF_TopPage,"")
               }
         }
      //
      copy(getAxNbF_BotPage,FicIndex.ligne.AttachedBottom)
      if(getAxNbF_BotPage=="")
         {
            itread(getAxNbF_BotPage,TabEdoc,"3",FicIndex.ligne.CodeModele)
            if(getAxNbF_BotPage=="undefined")
               {
                  copy(getAxNbF_BotPage,"")
               }
         }
      copy(InTraceExec_TypeMessage,"I")
      copy(InTraceExec_Message,"getAxNbF_BotPage["getAxNbF_BotPage"] FicIndex.ligne.CodeModele["FicIndex.ligne.CodeModele"]")
	  gosub(GenTraceExec)
      //
      copy(getAxNbF_DocPage,FicIndex.ligne.NbFeuillet)
      copy(getAxNbF_EdocDir,wrsPath)
	  //
      copy(InTraceExec_TypeMessage,"I")
      copy(InTraceExec_Message,"getAxNbF_EdocDir["getAxNbF_EdocDir"]")
	  gosub(GenTraceExec)
	  //
      gosub(getAxNbF)
      copy(FCT_TOTFEUILLET,getAxNbF_TotalP)
      //
      //
      copy(sbuffer,"")
      //
      call(_sbuffer,LB_RegExpReplace,inToWrite.ligne.Filler,CST2QUOT,"","REPEAT")
      if(_sbuffer=="NOT FOUND")
         {
            append(sbuffer,inToWrite.ligne.Filler)
         }
      else
         {
            append(sbuffer,_sbuffer)
         }
      //
      //20140626 : MDP - La Banque Postale positionner le nom de lot destination
      copy(pyGetDestination_postcode,FicIndex.ligne.CodePostal)
      copy(pyGetDestination_country,FicIndex.ligne.Pays)
      gosub(pyGetDestination)
      if(pyGetDestination_Resu="oui")
         {
            copy(FCT_DESTLOT,pyGetDestination_dest)
         }
      //
      call(EditionLen,LB_Strlen,FicIndex.ligne.ModeEdition)
      fornum(i,"1",EditionLen,"1")
         {
            call(canal,LB_SubString,FicIndex.ligne.ModeEdition,"P"i,"L1")
            //20140627 : MDP - La Banque Postale - transcoder le I en D pour MDP
            copy(wkey,FicIndex.ligne.Reseau"_"canal)
            itread(wcanal,TabCanalTrans,"1",wkey)
            if(wcanal!="undefined")
               {
                  copy(canal,wcanal)
               }
            //
            copy2("FCT_"canal,canal)
            //Mettre a jour les canaux de distribution
            call(TypeFlagEdition,LB_ExistStr,OutReadHeader_ModeEdition,canal,"")
            if(TypeFlagEdition!="FOUND")
               {
                  append(OutReadHeader_ModeEdition,canal)
               }
         }
