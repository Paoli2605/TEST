write(pjFdfOut,"<< /T (References) /V ("pjFdfVpfIdx.ligne.References") >>\n")
write(pjFdfOut,"<< /T (CodeModele) /V ("pjFdfVpfIdx.ligne.CodeModele") >>\n")
write(pjFdfOut,"<< /T (CodeVariante) /V ("pjFdfVpfIdx.ligne.CodeVariante") >>\n")
write(pjFdfOut,"<< /T (RefGED) /V ("pjFdfVpfIdx.ligne.RefGED") >>\n")
write(pjFdfOut,"<< /T (Application) /V ("pjFdfVpfIdx.ligne.Application") >>\n")
write(pjFdfOut,"<< /T (Section) /V ("pjFdfVpfIdx.ligne.Section") >>\n")
write(pjFdfOut,"<< /T (Responsable) /V ("pjFdfVpfIdx.ligne.Responsable") >>\n")
write(pjFdfOut,"<< /T (LieuEdition) /V ("pjFdfVpfIdx.ligne.LieuEdition") >>\n")
write(pjFdfOut,"<< /T (RefCourTech) /V ("pjFdfVpfIdx.ligne.RefCourTech") >>\n")
write(pjFdfOut,"<< /T (ValID) /V ("pjFdfVpfIdx.ligne.ValID") >>\n")
write(pjFdfOut,"<< /T (Quaduti) /V ("pjFdfVpfIdx.ligne.Quaduti") >>\n")
