PROC(GSRenommeFichier)
//********************************************************
// Renommage d'un fichier (sert au deplacement sans copie)
//*********************************************************
//
// GenRenommeFichier             IN  : InRenommeFichier_Source
//                               IN  : InRenommeFichier_Cible
//                               OUT : OutRenommeFichier_Resu
//------------------------------------------------------------------------
//
//Recherche de l'existence du fichier cible
//-----------------------------------------
//==================================================
//20140811 : ne pas renommer les fichiers identiques
//==================================================
if(InRenommeFichier_Cible!=InRenommeFichier_Source)
   {
      copy(pyGSFileExist_InFile,InRenommeFichier_Source)
      call(pyGSFileExist_return,switchmodule,"pyGSFileExist",pyDeliveryOutils)
      copy(LocRenommeFichier_Resu,pyGSFileExist_Resu)
      if(LocRenommeFichier_Resu!="OK")
         {
            copy(InTraceExec_TypeMessage,"W")
            copy(InTraceExec_Message,"Fichier source : "InRenommeFichier_Source" ==> absent")
            gosub(GenTraceExec)
            copy(OutRenommeFichier_Resu,"non")
            EXITPROC
         }
      //
      copy(pyGSFileExist_InFile,InRenommeFichier_Cible)
      call(pyGSFileExist_return,switchmodule,"pyGSFileExist",pyDeliveryOutils)
      copy(LocRenommeFichier_Resu,pyGSFileExist_Resu)
      if(LocRenommeFichier_Resu!="KO")
         {
            copy(InTraceExec_TypeMessage,"W")
            copy(InTraceExec_Message,"Fichier cible déjà présent : "InRenommeFichier_Cible" ==> effacement")
            gosub(GenTraceExec)
            //suppression de la cible
            //------------------------
            copy(pyGSFile_Remove_InFile,InRenommeFichier_Cible)
            call(pyGSFile_Remove_return,switchmodule,"pyGSFile_Remove",pyDeliveryOutils)
            copy(LocRenommeFichier_Resu,pyGSFile_Remove_Resu)
            if(LocRenommeFichier_Resu!="OK")
               {
                  copy(InTraceExec_TypeMessage,"W")
                  copy(InTraceExec_Message,"Fichier "InRenommeFichier_Cible)
                  gosub(GenTraceExec)
                  copy(OutRenommeFichier_Resu,"non")
                  EXITPROC
               }
         }
      if(InRenommeFichier_Source!=InRenommeFichier_Cible)
         {
            copy(pyGSFile_Rename_InSrcFile,InRenommeFichier_Source)
            copy(pyGSFile_Rename_InDstFile,InRenommeFichier_Cible)
            call(pyGSFile_Rename_return,switchmodule,"pyGSFile_Rename",pyDeliveryOutils)
            copy(LocRenommeFichier_Resu,pyGSFile_Rename_Resu)
            if(LocRenommeFichier_Resu!="OK")
               {
                  copy(InTraceExec_TypeMessage,"W")
                  copy(InTraceExec_Message,"GSRenommeFichier. Fichier "InRenommeFichier_Source" non renommé/déplacé en "InRenommeFichier_Cible)
                  gosub(GenTraceExec)
                  copy(OutRenommeFichier_Resu,"non")
                  EXITPROC
               }
            else
