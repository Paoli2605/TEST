PROC(getAxNbF)
//*******************************************************************************
// Calculer le nombre de feuillets du documents
//*******************************************************************************
// Parametres
//   getAxNbF_ImpMode  : simplex/duplex 
//   getAxNbF_EdocDir  : repertoire des ressources 
//   getAxNbF_FondPage : fond de page 
//   getAxNbF_DocPage  : nombre de page du document 
//   getAxNbF_TopPage  : liste des documents top
//   getAxNbF_BopPage  : liste des documents bottom
//   getAxNbF_TotalP   : nombre de pages des annexes
//-------------------------------------------------------------------------------
//
copy(getAxNbF_Resu,"OK")
//
//Nb pages pour Fond de page
calc(nbFPage=0)
if(getAxNbF_FondPage!="")
   {
      forset(elpath,getAxNbF_EdocDir,",","1")
         {
            forset(elm,getAxNbF_FondPage,",","1")
               {
                  calc(bpage=1,"99")
                  copy(wpath,elpath"/"elm"_"bpage".jpg")
                  copy(pyGSFileExist_InFile,wpath)
                  call(pyGSFileExist_return,switchmodule,"pyGSFileExist",pyDeliveryOutils)
                  copy(fexist,pyGSFileExist_Resu)
                  while(fexist=="OK")
                     {
                        calc(nbFPage=nbFPage+1)
                        //
                        calc(bpage=bpage+1,"99")
                        copy(wpath,elpath"/"elm"_"bpage".jpg")
                        copy(pyGSFileExist_InFile,wpath)
                        call(pyGSFileExist_return,switchmodule,"pyGSFileExist",pyDeliveryOutils)
                        copy(fexist,pyGSFileExist_Resu)
                     }
               }
         }
      //Positionner les pages excedentes
      if(getAxNbF_DocPage>=nbFPage)
         {
            calc(nbFPage=0)
         }
      else
         {
            calc(nbFPage=nbFPage-getAxNbF_DocPage)
         }
   }
//
//Nb Top pages pour Fond de page
calc(nbTPage=0)
if(getAxNbF_TopPage!="")
   {
      forset(elpath,getAxNbF_EdocDir,",","1")
         {
            forset(elm,getAxNbF_TopPage,",","1")
               {
                  calc(bpage=1,"99")
                  copy(wpath,elpath"/"elm"_"bpage".jpg")
                  copy(pyGSFileExist_InFile,wpath)
                  call(pyGSFileExist_return,switchmodule,"pyGSFileExist",pyDeliveryOutils)
                  copy(fexist,pyGSFileExist_Resu)
                  calc(_nbTPage=0)
                  while(fexist=="OK")
                     {
                        calc(_nbTPage=_nbTPage+1)
                        //
                        calc(bpage=bpage+1,"99")
                        copy(wpath,elpath"/"elm"_"bpage".jpg")
                        copy(pyGSFileExist_InFile,wpath)
                        call(pyGSFileExist_return,switchmodule,"pyGSFileExist",pyDeliveryOutils)
                        copy(fexist,pyGSFileExist_Resu)
                     }
                  //Get Doc Print Mode
                  copy(AttDocPrMode_DocName,elm)
                  gosub(AttDocPrMode)
                  if(AttDocPrMode=="duplex")
                     {
                        calc(_nbTPage=(_nbTPage+1)/2)
                     }
                  else
                     {
                        if(AttDocPrMode=="auto")
                           {
                              if(getAxNbF_ImpMode=="duplex")
                                 {
                                    calc(_nbTPage=(_nbTPage+1)/2)
                                 }
                           }
                     }
                  calc(nbTPage=nbTPage+_nbTPage)
               }
         }
   }
//Nb Top pages
calc(nbBPage=0)
if(getAxNbF_BotPage!="")
   {
      forset(elpath,getAxNbF_EdocDir,",","1")
         {
            forset(elm,getAxNbF_BotPage,",","1")
               {
                  calc(bpage=1,"99")
                  copy(wpath,elpath"/"elm"_"bpage".jpg")
                  copy(pyGSFileExist_InFile,wpath)
                  call(pyGSFileExist_return,switchmodule,"pyGSFileExist",pyDeliveryOutils)
                  copy(fexist,pyGSFileExist_Resu)
                  calc(_nbBPage=0)
                  while(fexist=="OK")
                     {
                        calc(_nbBPage=_nbBPage+1)
                        //
                        calc(bpage=bpage+1,"99")
                        copy(wpath,elpath"/"elm"_"bpage".jpg")
                        copy(pyGSFileExist_InFile,wpath)
                        call(pyGSFileExist_return,switchmodule,"pyGSFileExist",pyDeliveryOutils)
