            copy(RefGED,FicIndex.ligne.RefGED)
            copy(InfoGED,FicIndex.ligne.InfoGED)
            copy(NomCourtPDF,InIdTrt"_"RefGED"_"FicIndex.calcul.Numero".pdf")
