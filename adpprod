      calc(LocToutesErreurs_NbErreurs=LocToutesErreurs_NbErreurs+1)
      call(LocToutesErreurs_TmpErreurs,LB_ErrorGet,"CURRENT")
   }
copy(OutToutesErreurs_Erreurs,LocToutesErreurs_Erreurs)
