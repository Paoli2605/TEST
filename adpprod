PROC(pySubprocessingOpEngine)
//*****************************************************************************************************
// Run OpenPrint in multiple processing mode. Si l'une des commande echoue, l'ensemble des commande
// est considere echouees
//*****************************************************************************************************
// Input Parameters :
//   pySubprocessingOpEngine_InOpCmdListe      :  liste de commande a executer en multithread
//                                                les commandes sont separees par le caractere '\n'
// Output Parameters :
//   pySubprocessingOpEngine_return : OK/KO
//   pySubprocessingOpEngine_msgerr : Message Erreur, vide si non erreur
//   pySubprocessingOpEngine_procstat : etat des process executer
// Historique des modifications
//-----------------------------------------------------------------------------------------------------
copy(pySubprocessingOpEngine_Resu,"oui")
//
copy(InTraceExec_TypeMessage,"I")
copy(InTraceExec_Message,"Debut Executer assemblage en multiprocessing")
copy(InTraceExec_Needed,"oui")
gosub(GenTraceExec)
//
copy(pySubprocessingOpEngine_procstat,"")
//
call(pySubprocessingOpEngine_return,switchmodule,"pySubprocessingOpEngine",pyGsTool)
//
// Test d'erreur d'execution
if((pySubprocessingOpEngine_return!="Defined")||(pySubprocessingOpEngine_msgerr!=""))
   {
      copy(InTraceExec_TypeMessage,"E")
      copy(InTraceExec_Message,"pySubprocessingOpEngine Identification Exit Code : -1")
      gosub(GenTraceExec)
      // - Trace Erreur      
      copy(InTraceExec_TypeMessage,"E")
      copy(InTraceExec_Message,"Erreur pySubprocessingOpEngine ["pySubprocessingOpEngine_msgerr"]")
      gosub(GenTraceExec)
      copy(FlagArret,"oui")
      copy(pySubprocessingOpEngine_Resu,"non")
      //      
      //EXITPROC
   }
else
   {
      copy(InTraceExec_TypeMessage,"I")
      copy(InTraceExec_Message,"pySubprocessingOpEngine Identification Exit Code : 0")
      gosub(GenTraceExec)
   }
//
//================================
//Trace les status des executions 
//================================
forset(cmd,pySubprocessingOpEngine_procstat,"\n","1")
   {
      copy(_cmdline,"")
      copy(_ret,"")
      copy(_gret,"0")
      forset(elt,cmd,"\t","1")
         {
            if(_cmdline=="")
               {
                  copy(_cmdline,elt)
               }
            else
               {
                  copy(_ret,elt)
               }
         }
      //
      if(_ret=="0")
         {
            copy(InTraceExec_TypeMessage,"I")
         }
      else
         {
            copy(InTraceExec_TypeMessage,"E")
            copy(_gret,_ret)
         }
      //      
      //Tracer les lignes de commandes et codes retour
      copy(InTraceExec_Message,_cmdline)
      gosub(GenTraceExec)
      copy(InTraceExec_TypeMessage,"I")
      copy(InTraceExec_Message,"Identification Exit Code : "_ret)
      gosub(GenTraceExec)
   }
//
//=========================================
//Gerer le bck des traitements en parallele
//=========================================
calc(_gret=_gret)
if(_gret!="0")
   {
      gosub(GSDeplaceBck)
   }
else
   {
      gosub(GSPurgeBck)
   }
//
copy(InTraceExec_TypeMessage,"I")
copy(InTraceExec_Message,"Fin Executer assemblage en multiprocessing")
copy(InTraceExec_Needed,"oui")
gosub(GenTraceExec)
ENDPROC
