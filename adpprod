               {
                  copy(_previousVpf,_currentVpf)
                  append(ListeFicTrt,_currentVpf"\n")
                  append(ListeFicTrt,_currentVpfCourt"\n")
                  append(ListeFicTrt,_currentVpfInd"\n")
