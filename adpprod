		if(rspath!="")
			{
				copy(doc2include,"true")
				copy(ingetFullPathRes,rspath)
				gosub(getFullPathRes)
				if(getFullPathRes_Resu=="oui")
				{
					copy(rspath,outgetFullPathRes)
				}
				else
				{
					copy(pdfMerge_LoopOut,"true")
					copy(pdfMerge_Resu,"non")
					setin(vpfFicIndex,"eclatement.tab","- NO IN -")
					setout(pdfFicIndex,"- NO OUT -")
					EXITPROC
				}
			}
		//
		append(pdfMerge_indexline,"\t"rspath)
		//attached top document
		copy(rspath,vpfFicIndex.ligne.AttachedTop)
		if(rspath=="")
			{
				itread(rspath,TabEdoc,"2",vpfFicIndex.ligne.CodeModele)
				if(rspath=="undefined")
				{
					copy(rspath,"")
				}
			}
		//
		if(rspath!="")
			{
				copy(doc2include,"true")
				copy(buffer,"")
				forset(ires,rspath,",","1")
				{
					copy(ingetFullPathRes,ires)
					gosub(getFullPathRes)
					if(getFullPathRes_Resu=="oui")
						{
							if(buffer=="")
							{
								copy(buffer,outgetFullPathRes)
							}
							else
							{
								append(buffer,","outgetFullPathRes)
							}
						}
					else
						{
							copy(pdfMerge_LoopOut,"true")
							copy(pdfMerge_Resu,"non")
							setin(vpfFicIndex,"eclatement.tab","- NO IN -")
							setout(pdfFicIndex,"- NO OUT -")
							EXITPROC
						}
				}
				copy(rspath,buffer)
			}
		//
		append(pdfMerge_indexline,"\t"rspath)
		//
		//attached bottom document
		copy(rspath,vpfFicIndex.ligne.AttachedBottom)
		if(rspath=="")
			{
				itread(rspath,TabEdoc,"3",vpfFicIndex.ligne.CodeModele)
				if(rspath=="undefined")
				{
					copy(rspath,"")
				}
			}
		if(rspath!="")
			{
				copy(doc2include,"true")
				copy(buffer,"")
				forset(ires,rspath,",","1")
				{
					copy(ingetFullPathRes,ires)
					gosub(getFullPathRes)
					if(getFullPathRes_Resu=="oui")
						{
							if(buffer=="")
							{
								copy(buffer,outgetFullPathRes)
							}
							else
							{
								append(buffer,","outgetFullPathRes)
							}
						}
					else
						{
							copy(pdfMerge_LoopOut,"true")
							copy(pdfMerge_Resu,"non")
							setin(vpfFicIndex,"eclatement.tab","- NO IN -")
							setout(pdfFicIndex,"- NO OUT -")
							EXITPROC
						}
				}
				copy(rspath,buffer)
			}
		//
		append(pdfMerge_indexline,"\t"rspath)
		//
		write(pdfFicIndex,pdfMerge_indexline"\n")
	  }
      copy(pdfMerge_indexline,"")
      //
      read(vpfFicIndex,"theader")
      read(vpfFicIndex,"ligne")
      read(vpfFicIndex,"fonction")
      read(vpfFicIndex,"calcul")
   }
