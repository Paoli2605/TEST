                  // Trace de lancement
                  copy(InTraceExec_TypeMessage,"I")
                  copy(InTraceExec_Message,EngineGo)
                  copy(InTraceExec_Needed,"oui")
                  gosub(GenTraceExec)
                  //
                  // Lancement
                  gosub(GSgo_gene)
