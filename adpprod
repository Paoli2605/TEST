      gosub(GenTraceExec)
      copy(FlagArret,"oui")
      copy(ModelTranslate_Resu,"non")
      EXITPROC
   }
//
forset(NddXmlFichier,wNddXmlList,"\n","1")
   {
      // Mise a jour des fichiers creés
      append(ListeFicTrt,NddXmlFichier"\n")
      //
      //20150511 - verifier le nouveau modele existe
      //
      //recuperer le code modele
      copy(XmlHeaderFile,RepTravail"/"NddXmlFichier)
      gosub(getXmlHeader)
      //
      //Verifier la presence du nouveau modele
      copy(InEnvMO_OpWD,OpWDMO)
      copy(InEnvMO_CodeModele,OutReadHeader_CodeModele""NvModelePostFix)
      //20121221 : livraison par tag
      copy(InEnvMO_Version,"undefined")
      gosub(GSEnvMO)
      //Pas de nouveau modele associe 
      if(OutEnvMO_Resu!="oui")
         {
            if(NddXmlList="")
               {
                  copy(NddXmlList,NddXmlFichier)
               }
            else
               {
                  append(NddXmlList,"\n")
                  append(NddXmlList,NddXmlFichier)
               }
         }
      else
         {
            //
            //*******************************
            //recuperer le xml ancien modele 
            //*******************************
            //
            copy(wXmlFile,wOldModelPrefix""NddXmlFichier)
            append(ListeFicTrt,wXmlFile"\n")
            //
            copy(InTraceExec_TypeMessage,"I")
            copy(InTraceExec_Message,"pyXslt_xsl=["EXslDir"/"XslGetOldModele"] pyXslt_xml=["RepTravail"/"NddXmlFichier"] pyXslt_out=["RepTravail"/"wXmlFile"]")
