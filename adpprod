            gosub(GenTraceExec)
            copy(FlagArret,"oui")
            copy(getDisposePath_Resu,"non")
            EXITPROC
         }
      //
      if(_wkey!="undefined")
         {
            //Chercher le path dans la table de mise a disposition
            itread(getDisposePath_path,TabPdfDispose,"1",_wkey)
            gosub(GenGetErreur)
            if(OutGetErreur_Erreur!="")
               {
                  copy(InTraceExec_TypeMessage,"E")
                  copy(InTraceExec_Message,"Erreur de lecture de la table "TabPdfDispose" ["OutGetErreur_Erreur"]")
                  gosub(GenTraceExec)
                  copy(FlagArret,"oui")
                  copy(getDisposePath_Resu,"non")
                  EXITPROC
               }
            //
            if(getDisposePath_path!="undefined")
               {
                  //GF - 20250321 - Permet de créer l'arborescence à la volé si non existante
                  copy(pyGSPresenceRepertoire_InsCheminRep,getDisposePath_path)
                  call(pyGSFileExist_return,switchmodule,"pyGSPresenceRepertoire",pyDeliveryOutils)
