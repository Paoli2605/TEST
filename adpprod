PROC(pdfMerge)
//*******************************************************************************
// Merging fondpage and attached documents to the final pdf document
//*******************************************************************************
// Parameters :
//   InpdfMerge_vpfIndex
//   InpdfMerge_pdfFile
//   InpdfMerge_logFile
//   InpdfMerge_outpdfFile
//-------------------------------------------------------------------------------
copy(pdfMerge_Resu,"oui")
copy(doc2include,"false")
copy(pdfMerge_LoopOut,"false")
//
copy(InTraceExec_TypeMessage,"I")
copy(InTraceExec_Message,"pdfMerge")
gosub(GenTraceExec)
//
copy(pdfMerge_indexfile,InpdfMerge_pdfFile".ind")
copy(pdfMerge_indexline,"")
//Check pdf file
copy(InPresenceFichier_Fichier,InpdfMerge_pdfFile)
gosub(GSPresenceFichier)
if(OutPresenceFichier_Resu!="oui")
   {
      copy(pdfMerge_Resu,"non")
      copy(FlagArret,"oui")
      EXITPROC
   }
//Check pdf Index file
copy(InPresenceFichier_Fichier,InpdfMerge_vpfIndex)
gosub(GSPresenceFichier)
if(OutPresenceFichier_Resu!="oui")
   {
      copy(pdfMerge_Resu,"non")
      copy(FlagArret,"oui")
      EXITPROC
   }
//
setin(vpfFicIndex,"eclatement.tab",InpdfMerge_vpfIndex)
oneof(vpfFicIndex,"- SET EOF VAR -")
//
setout(pdfFicIndex,pdfMerge_indexfile)
//
//lecture ligne d'entete
read(vpfFicIndex,"entete")
//
//lecture 1 er document
read(vpfFicIndex,"theader")
read(vpfFicIndex,"ligne")
read(vpfFicIndex,"fonction")
read(vpfFicIndex,"calcul")
//
while((vpfFicIndex_eof==0)&&(pdfMerge_LoopOut=="false"))
   {
      //Pdf start with 1
      calc(pdfMerge_indexline=vpfFicIndex.ligne.boffset+1)
      append(pdfMerge_indexline,"_"vpfFicIndex.ligne.nbpageoffset)
	  copy(InTraceExec_TypeMessage,"ABGM")
      copy(InTraceExec_Message,"boffset_nbpageoffset : "vpfFicIndex.ligne.boffset"_"vpfFicIndex.ligne.nbpageoffset)
      gosub(GenTraceExec)
	  // Ne traiter que les lignes avec des pages (nbpageoffset > 0)
      calc(_nbpageoffset=vpfFicIndex.ligne.nbpageoffset)
      if(_nbpageoffset>"0")
	  {
		//fondpage
		copy(rspath,vpfFicIndex.ligne.FondPage)
		//Try to get fondpage from configuration table
		if(rspath=="")
			{
				itread(rspath,TabEdoc,"1",vpfFicIndex.ligne.CodeModele)
				if(rspath=="undefined")
				{
					copy(rspath,"")
				}
			}
