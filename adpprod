PROC(GenTraceExec)
//****************************************************************
//   PROCEDURES GENERIQUES DE TRAITEMENT D'UN MESSAGE DETAILLE
//****************************************************************
//
// GenTraceExec                 IN  : InTraceExec_NomTrace
//                                    InTraceExec_RepTrace
//                                    InTraceExec_CodeMessage
//                                    InTraceExec_Message
//                                    InTraceExec_LogDetail
//                                    InTraceExec_Needed
//                                   
//----------------------------------------------------------------
//
// Declaration du fichier trace
//-----------------------------
//
// recuperation de la date et heure courante
//---------------------------------
call(LocTraceExec_TimeMessage,LB_GetTime,"")
call(LocTraceExec_TmpCurrentDate,LB_GetDate,"")
if(LocTraceExec_CurrentDate!=LocTraceExec_TmpCurrentDate)
   {
      cp(LocTraceExec_CurrentDate,LocTraceExec_TmpCurrentDate)
      call(LocTraceExec_TmpJour,LB_SousChaine,LocTraceExec_CurrentDate,"P1","L2")
      call(LocTraceExec_TmpMois,LB_SousChaine,LocTraceExec_CurrentDate,"P4","L2")
      call(LocTraceExec_TmpAnnee,LB_SousChaine,LocTraceExec_CurrentDate,"P7","L4")
      copy(LocTraceExec_DateMessage,LocTraceExec_TmpJour""LocTraceExec_TmpMois)
   }
//
if(LocTraceExec_FlagTrace!="oui")
   {
      setout(OutTracePJ,InTraceExec_RepTrace"/"LocTraceExec_DateMessage"_"InTraceExec_NomTrace)
      copy(LocTraceExec_FlagTrace,"oui")
      gosub(GenGetErreur)
      if(OutGetErreur_Erreur!="")
         {
            setout(OutTrace,"erreur.log")
            write(OutTrace,"Erreur : "OutGetErreur_Erreur"\n")
            write(OutTrace,"Erreur lors de la création de la trace "InTraceExec_RepTrace"/"LocTraceExec_DateMessage"_"InTraceExec_NomTrace)
            copy(FlagArret,"oui")
            EXITPROC
         }
   }
//
if(InTraceExec_LogDetail=="oui")||(InTraceExec_Needed=="oui")||(InTraceExec_TypeMessage=="W")||(InTraceExec_TypeMessage=="E")
   {
      write(OutTracePJ,InTraceExec_TypeMessage"|"LocTraceExec_DateMessage"|"LocTraceExec_TimeMessage"|"InTraceExec_IdExec"|"InTraceExec_NomStep"|"InTraceExec_Message"\n")
   }
copy(InTraceExec_Needed,"non")
ENDPROC
