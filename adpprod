PROC(buildGlobalMacroTab)
//********************************************************
// Build a uniq macro table for xml file modeles
//********************************************************
//--------------------------------------------------------
//
itcreate(_opAppli,"1")
copy(_opAppliExist,"")
//
copy(_macrostabFile,RepTravail"/"InIdTrt"_macros.tab")
setout(OutMacrosTab,_macrostabFile)
//
copy(pyGSFileExist_InFile,OpWDMO"/common/macro/macros.tab")
call(pyGSFileExist_return,switchmodule,"pyGSFileExist",pyDeliveryOutils)
copy(OutGetErreur_Erreur,pyGSFileExist_Resu)
if(OutGetErreur_Erreur=="OK")
   {
      load(_macrosbuffer,OpWDMO"/common/macro/macros.tab")
      // Si erreur de chargement
      gosub(GenGetErreur)
      if(OutGetErreur_Erreur=="")
         {
            write(OutMacrosTab,_macrosbuffer)
            write(OutMacrosTab,"\n")
         }
   }
//
load(_macrosbuffer,OpWDMO"/"OutEnvMO_Famille"/common/macro/macros.tab")
// Si erreur de chargement
gosub(GenGetErreur)
if(OutGetErreur_Erreur=="")
   {
      write(OutMacrosTab,_macrosbuffer)
      write(OutMacrosTab,"\n")
   }
//=======================================
//Constistuer la table globale des macros
//=======================================
forset(NddXmlFichier,NddXmlList,"\n","1")
   {
      itread(wOutEnvMO_Famille,_NDDMODELETAB,1,NddXmlFichier)
      itread(wOutEnvMO_Appli,_NDDMODELETAB,2,NddXmlFichier)
      itread(_opAppliExist,_opAppli,1,wOutEnvMO_Appli)
      if(_opAppliExist=="undefined")
         {
            itadd(_opAppli,wOutEnvMO_Appli,wOutEnvMO_Appli)
            //===
            //fusionner les tables des macros
            //===
            copy(InSubMacTabFichier,OpWDMO"/"wOutEnvMO_Famille"/"wOutEnvMO_Appli"/macro/macros.tab")
            gosub(GSSubMacTab)
            if(OutSubMacTab_Resu!="oui")
               {
                  copy(InTraceExec_TypeMessage,"E")
                  copy(InTraceExec_Message,"Erreur de chargement du fichier:"OpWDMO"/"wOutEnvMO_Famille"/"wOutEnvMO_Appli"/macro/macros.tab: "OutSubMacTab_Resu)
                  copy(InTraceExec_Needed,"oui")
                  gosub(GenTraceExec)
                  copy(FlagArret,"oui")
                  EXITPROC
               }
            write(OutMacrosTab,RetSubMacTab_Buf)
            write(OutMacrosTab,"\n")
         }
      //
      //11/01/05
      //Delivery macro tab
      load(_macrosbuffer,OpWDDlv"/"FamilleDlv"/"AppliDlv"/macro/"AppliDlv"_bac.tab")
      gosub(GenGetErreur)
      if(OutGetErreur_Erreur=="")
         {
            call(_var,LB_RegExpReplace,_macrosbuffer,"\t","\t"OpWDDlv"/"FamilleDlv"/"AppliDlv"/macro/","REPEAT")
            if(_var=="NOT FOUND")
               {
                  write(OutMacrosTab,_macrosbuffer)
               }
            else
               {
                  write(OutMacrosTab,_var)
               }
            write(OutMacrosTab,"\n")
         }
   }
//
setout(OutMacrosTab,"- NO OUT -")
itdeletetab(_opAppli)
append(ListeFicTrt,InIdTrt"_macros.tab\n")
ENDPROC
