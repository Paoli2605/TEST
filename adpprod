                        if(pyGSRCreeRepertoire_return!="OK")
                           {
                              copy(InTraceExec_TypeMessage,"E")
                              copy(InTraceExec_Message,"Erreur lors de la creation du repertoire "getDisposePath_path" ["pyGSRCreeRepertoire_msgerr"]")
                              gosub(GenTraceExec)
                              copy(FlagArret,"oui")
                              copy(getDisposePath_Resu,"non")
                              EXITPROC
                           }
                     }
                  copy(wfound,"1")
               }
         }
      calc(_varKey=_varKey+1)
   }
