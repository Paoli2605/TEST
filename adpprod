PROC(prefillPjForm)
//*******************************************************************************
// Pre-remplit un formulaire PDF via pdftk fill_form avec les donnees du VPF index
//*******************************************************************************
// Parameters
//   InPrefillPj_PjName   : nom de la PJ formulaire (sans chemin ni extension)
//   InPrefillPj_FdfSkel  : chemin complet du squelette FDF dans /tmp/
//   InPrefillPj_VpfInd   : chemin complet du fichier index VPF
//   InPrefillPj_PdftKExe : chemin complet de l'executable pdftk
//   OutPrefillPj_Resu    : oui/non
//-------------------------------------------------------------------------------
copy(OutPrefillPj_Resu,"oui")
//
// Etape 1 : Copier la PJ formulaire depuis common vers RepTravail (suffixe _form)
copy(pjSrcPath,OpWDDlv"/"FamilleDlv"/common/edoc/pdf/"InPrefillPj_PjName".pdf")
copy(pjFormCopy,RepTravail"/"InPrefillPj_PjName"_form.pdf")
copy(InCopieFichier_Source,pjSrcPath)
copy(InCopieFichier_Cible,pjFormCopy)
gosub(GSCopieFichier)
if(OutCopieFichier_Resu!="oui")
   {
      copy(InTraceExec_TypeMessage,"E")
      copy(InTraceExec_Message,"prefillPjForm : impossible de copier la PJ ["pjSrcPath"]")
      gosub(GenTraceExec)
      copy(OutPrefillPj_Resu,"non")
      EXITPROC
   }
//
// Etape 2 : Copier le squelette FDF depuis /tmp/ vers RepTravail
copy(pjFdfSkelCopy,RepTravail"/"InPrefillPj_PjName"_skel.fdf")
copy(InCopieFichier_Source,InPrefillPj_FdfSkel)
copy(InCopieFichier_Cible,pjFdfSkelCopy)
gosub(GSCopieFichier)
if(OutCopieFichier_Resu!="oui")
   {
      copy(InTraceExec_TypeMessage,"W")
      copy(InTraceExec_Message,"prefillPjForm : squelette FDF introuvable ["InPrefillPj_FdfSkel"] - continue")
      gosub(GenTraceExec)
   }
//
// Etape 3 : Generer le FDF rempli depuis l'index VPF
copy(pjFdfFilled,RepTravail"/"InPrefillPj_PjName"_filled.fdf")
copy(InFillFdf_VpfInd,InPrefillPj_VpfInd)
copy(InFillFdf_OutputFdf,pjFdfFilled)
gosub(fillFdfFromIndex)
if(OutFillFdf_Resu!="oui")
   {
      copy(InTraceExec_TypeMessage,"E")
      copy(InTraceExec_Message,"prefillPjForm : erreur generation FDF pour ["InPrefillPj_PjName"]")
      gosub(GenTraceExec)
      copy(OutPrefillPj_Resu,"non")
      EXITPROC
   }
//
// Etape 4 : Appel pdftk fill_form -> sortie dans RepTravail/<pjname>.pdf
copy(pjPrefillOut,RepTravail"/"InPrefillPj_PjName".pdf")
copy(pdftk_fill_params,"")
append(pdftk_fill_params,pjFormCopy)
append(pdftk_fill_params," fill_form ")
append(pdftk_fill_params,pjFdfFilled)
append(pdftk_fill_params," output ")
append(pdftk_fill_params,pjPrefillOut)
append(pdftk_fill_params," flatten")
//
copy(InTraceExec_TypeMessage,"I")
copy(InTraceExec_Message,"prefillPjForm pdftk : "InPrefillPj_PdftKExe" "pdftk_fill_params)
copy(InTraceExec_Needed,"oui")
gosub(GenTraceExec)
//
copy(pyGSRunProcess_InFullPathToExe,InPrefillPj_PdftKExe)
copy(pyGSRunProcess_InParameters,pdftk_fill_params)
copy(pyGSRunProcess_InEnv,"")
call(pyGSRunProcess_return,switchmodule,"pyGSRunProcess",pyDeliveryOutils)
copy(pjPdftk_resu,GSRunProcess_Resu)
if(pjPdftk_resu!="OK")
   {
      copy(InTraceExec_TypeMessage,"E")
      copy(InTraceExec_Message,"prefillPjForm : erreur pdftk fill_form pour ["InPrefillPj_PjName"]")
      gosub(GenTraceExec)
      copy(OutPrefillPj_Resu,"non")
      EXITPROC
   }
//
// Etape 5 : Verifier la presence du PDF de sortie
copy(pyGSFileExist_InFile,pjPrefillOut)
call(pyGSFileExist_return,switchmodule,"pyGSFileExist",pyDeliveryOutils)
copy(fexist,pyGSFileExist_Resu)
if(fexist!="OK")
   {
      copy(InTraceExec_TypeMessage,"E")
      copy(InTraceExec_Message,"prefillPjForm : PDF prefilled absent ["pjPrefillOut"]")
      gosub(GenTraceExec)
      copy(OutPrefillPj_Resu,"non")
      EXITPROC
   }
//
copy(InTraceExec_TypeMessage,"I")
copy(InTraceExec_Message,"prefillPjForm : formulaire prefilled OK -> "pjPrefillOut)
gosub(GenTraceExec)
ENDPROC
