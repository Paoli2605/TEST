PROC(getGedVarFrTab)
//*******************************************************************************
// 20131122 Ajout pour le projet SEPA
// Get Ged variables from table for current document
// All these variables could be set into the xml ged file
//*******************************************************************************
//-------------------------------------------------------------------------------
//
copy(getGedVarFrTab_Resu,"oui")
//
//=================================
//Recuperer les noms des variables
//=================================
copy(_resu,"")
//Cle pour recuprer les noms des varibales
copy(_varKey,"MODELE")
//cle pour recuperer les valeurs par defaut
copy(_varDefaultKey,"DEFAULT")
//
copy(_idx,"1")
calc(_getGedVarFrTab_nbvar=_idx+1)
//
itread(_resu,TabGed,_idx,_varKey)
gosub(GenGetErreur)
if(OutGetErreur_Erreur!="")
   {
      copy(getGedVarFrTab_Resu,"non")
      copy(FlagArret,"oui")
      EXITPROC
   }
//
while(_resu!="undefined")
   {
      //Positionner le nom de la variable courant
      copy2("_getGedVarFrTab_"_idx,_resu)
      //
      subst2(_destvar,"_getGedVarFrTab_"_idx)
      //Trace
      if(FlagMenage!="oui")
         {
            copy(InTraceExec_TypeMessage,"I")
            copy(InTraceExec_Message,"Variable _getGedVarFrTab_"_idx"=["_destvar"]")
            gosub(GenTraceExec)
         }
      //Incermenter Indice
      calc(_idx=_idx+1)
      //
      itread(_resu,TabGed,_idx,_varKey)
      //================================
      //Verifier si la derniere colonne 
      //================================
      gosub(GenGetErreur)
      if(OutGetErreur_Erreur!="")
         {
            copy(_resu,"undefined")
         }
      else
         {
            //Incrementer le nombre index
            calc(_getGedVarFrTab_nbvar=_idx+1)
            //Trace
            if(FlagMenage!="oui")
               {
                  copy(InTraceExec_TypeMessage,"I")
                  copy(InTraceExec_Message,"Indice _idx=["_idx"] _getGedVarFrTab_nbvar=["_getGedVarFrTab_nbvar"]")
                  gosub(GenTraceExec)
               }
         }
   }
//
//========================================
//Verifier si le modele existe
//Sinon positionber les valeurs par defaut
//========================================
copy(_idx,"1")
//
copy(_modelekey,FicIndex.ligne.CodeModele)
itread(_resu,TabGed,_idx,_modelekey)
//
gosub(GenGetErreur)
if(OutGetErreur_Erreur!="")
   {
      copy(getGedVarFrTab_Resu,"non")
      copy(FlagArret,"oui")
      EXITPROC
   }
//
//Recuperer la valeur par defaut
if(_resu=="undefined")
   {
      //================================
      //Modele non configure dans gedtab
      //================================
      copy(InTraceExec_TypeMessage,"W")
      copy(InTraceExec_Message,"Modele=["_modelekey"] non configure dans gedtab")
      gosub(GenTraceExec)
      //
      copy(_modelekey,_varDefaultKey)
      itread(_resu,TabGed,_idx,_modelekey)
      //
      gosub(GenGetErreur)
      if((OutGetErreur_Erreur!="")||(_resu=="undefined"))
         {
            //===============================================
            //Valeurs par defaut non configurees dans gedtab
            //===============================================
            copy(InTraceExec_TypeMessage,"E")
            copy(InTraceExec_Message,"Modele=["_modelekey"] non configure dans gedtab")
            gosub(GenTraceExec)
            copy(getGedVarFrTab_Resu,"non")
            copy(FlagArret,"oui")
            EXITPROC
         }
   }
//====================================
//Recuperer les valeurs des variables
//====================================
while(_idx<_getGedVarFrTab_nbvar)
   {
      itread(_resu,TabGed,_idx,_modelekey)
      gosub(GenGetErreur)
      if(OutGetErreur_Erreur!="")
         {
            copy(_resu,"undefined")
         }
      subst2(_destvar,"_getGedVarFrTab_"_idx)
      copy2(_destvar,_resu)
      subst2(_vvar,_destvar)
      //Trace
      if(FlagMenage!="oui")
         {
            copy(InTraceExec_TypeMessage,"I")
            copy(InTraceExec_Message,"_idx=["_idx"] _getGedVarFrTab_"_idx"=["_destvar"] valeur=["_vvar"]")
            gosub(GenTraceExec)
         }
      //
      calc(_idx=_idx+1)
   }
ENDPROC
