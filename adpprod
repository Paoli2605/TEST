            copy(pyXslt_xml,RepTravail"/"NddXmlFichier)
            copy(pyXslt_out,RepTravail"/"wXmlFile)
            copy(pyXslt_param,"")
            gosub(pyXslt)
            if(pyXslt_Resu!="oui")
               {
                  copy(ModelTranslate_Resu,"non")
                  EXITPROC
               }
            //
            copy(InPresenceFichier_Fichier,RepTravail"/"wXmlFile)
            gosub(GSPresenceFichier)
            if(OutPresenceFichier_Resu="oui")
               {
                  //recuperer le code modele
                  copy(pyIsMoDataLoader_xmlFile,RepTravail"/"wXmlFile)
                  gosub(pyIsMoDataLoader)
                  if(pyIsMoDataLoader_Resu!="oui")
                     {
                        EXITPROC
                     }
                  if(pyIsMoDataLoader_dataloader=="oui")
                     {
                        //re-formaliser le xml apres xmlt
                        copy(reFormatXml_InxmlFile,wXmlFile)
                        gosub(reFormatXml)
                        if(reformatXml_Resu!="oui")
                           {
                              EXITPROC
                           }
                        copy(wXmlFile,reFormatXml_OutxmlFile)
                     }
                  //
                  if(NddXmlList="")
                     {
                        copy(NddXmlList,wXmlFile)
                     }
                  else
                     {
                        append(NddXmlList,"\n")
                        append(NddXmlList,wXmlFile)
                     }
               }
            //
            //*******************************
            //recuperer le xml nouveau modele
            //*******************************
            //
            copy(wXmlFile,wNewModelPrefix""NddXmlFichier)
            append(ListeFicTrt,wXmlFile"\n")
            //
            copy(InTraceExec_TypeMessage,"I")
            copy(InTraceExec_Message,"pyXslt_xsl=["EXslDir"/"XslGetNewModele"] pyXslt_xml=["RepTravail"/"NddXmlFichier"] pyXslt_out=["RepTravail"/"wXmlFile"]")
            gosub(GenTraceExec)
            //
            copy(pyXslt_xsl,EXslDir"/"XslGetNewModele)
            copy(pyXslt_xml,RepTravail"/"NddXmlFichier)
            copy(pyXslt_out,RepTravail"/"wXmlFile)
            copy(pyXslt_param,"")
            gosub(pyXslt)
            if(pyXslt_Resu!="oui")
               {
                  copy(ModelTranslate_Resu,"non")
                  EXITPROC
               }
            //
            copy(InPresenceFichier_Fichier,RepTravail"/"wXmlFile)
            gosub(GSPresenceFichier)
            if(OutPresenceFichier_Resu="oui")
               {
                  if(NddXmlList="")
                     {
                        copy(NddXmlList,wXmlFile)
                     }
                  else
                     {
                        append(NddXmlList,"\n")
                        append(NddXmlList,wXmlFile)
                     }
               }
         }
   }
