                  append(EngineGo," -E opEuro=WINDOWS")
                  append(EngineGo," -E opInstallDir="OpInstallDir)
                  append(EngineGo," -E opWD="OpWDDlv)
                  append(EngineGo," -E opFam="FamilleDlv)
                  append(EngineGo," -E opAppli="AppliDlv)
                  append(EngineGo," -tm "AppliDlv".tab")
                  append(EngineGo," -M V")
                  append(EngineGo," -dn "ProtoAcr)
                  append(EngineGo," -iv "RepTravail"/"_currentVpf)
