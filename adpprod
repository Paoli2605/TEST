PROC(ModelTranslate)
//***************************************************************
// Model translate
//***************************************************************
// 20150402 - Bascule ancien vers nouveau modele             
// 20150511 - Conserver l'ancien modele si le nouveau non present 
//---------------------------------------------------------------
copy(ModelTranslate_Resu,"oui")
//
//load la liste des fichiers xml
copy(NddXmlList,"")
//prefixe des fichiers anciens modeles
copy(wOldModelPrefix,"old_")
//prefixe des fichiers nouveaux modeles
