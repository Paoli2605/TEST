//*******************************************************************
//              Recherche Famille/Appli/Dataloader pour le modèle MO
//*******************************************************************
// GenEnvMO
//                              IN :  InEnvMO_CodeModele
//                              IN :  InEnvMO_OpWD
//                              OUT : OutEnvMO_Resu
//                              OUT : OutEnvMO_Famille
//                              OUT : OutEnvMO_Appli
//                              OUT : OutEnvMO_Dataloader
//-------------------------------------------------------------------
//
PROC(GenEnvMO)
//chargement de la table des applis en prod 
itload(TabAppliMo,InEnvMO_OpWD"/common/tablei/applis.tab")
gosub(GenGetErreur)
// Si erreur de chargement
if(OutGetErreur_Erreur!="")
   {
      copy(InTraceExec_TypeMessage,"E")
      copy(InTraceExec_Message,"Erreur de chargement de la table des modeles MO en prod "InOpWDMO"/common/tablei/applis.tab")
      gosub(GenTraceExec)
      copy(OutEnvMO_Resu,"non")
      EXITPROC
   }
//lecture famille/application du modele Middle Office
itread(OutEnvMO_Famille,TabAppliMo,"4",InEnvMO_CodeModele)
itread(OutEnvMO_Appli,TabAppliMo,"3",InEnvMO_CodeModele)
itread(OutEnvMO_Dataloader,TabAppliMo,"5",InEnvMO_CodeModele)
//Cas d'erreur : le modèle n'est pas référencé dans la table de production
if(OutEnvMO_Famille=="undefined")||(OutEnvMO_Appli="undefined")||(OutEnvMO_Dataloader=="undefined")
   {
      copy(InTraceExec_TypeMessage,"W")
      copy(InTraceExec_Message,InEnvMO_CodeModele" non référencé dans l'environnement de production MiddleOffice")
      gosub(GenTraceExec)
      copy(OutEnvMO_Resu,"non")
      EXITPROC
   }
//Validation de la présence du XML de template
copy(InPresenceFichier_Fichier,OpWDMO"/"OutEnvMO_Famille"/"OutEnvMO_Appli"/template/"OutEnvMO_Appli".xml")
gosub(GSPresenceFichier)
//Le Xml de template n'est pas trouvé
if(OutPresenceFichier_Resu!="oui")
   {
      copy(InTraceExec_TypeMessage,"W")
      copy(InTraceExec_Message,"Xml de template non trouvé")
      gosub(GenTraceExec)
      copy(OutEnvMO_Resu,"non")
      EXITPROC
   }
//Validation de la présence du programme d'assemblage COMPILE
//si windows = dataloader.dll
if(OutInitWorkBench_Environnement=="Windows")
   {
      copy(InPresenceFichier_Fichier,OpWDMO"/"OutEnvMO_Famille"/common/program/"OutEnvMO_Dataloader".dll")
   }
else
   {
      //sinon sans extension
      copy(InPresenceFichier_Fichier,OpWDMO"/"OutEnvMO_Famille"/common/program/"OutEnvMO_Dataloader)
   }
gosub(GSPresenceFichier)
//L'exécutable n'est pas trouvé
if(OutPresenceFichier_Resu!="oui")
   {
      copy(InTraceExec_TypeMessage,"W")
      copy(InTraceExec_Message,"exécutable d'assemblage (Dataloader) non trouvé")
      gosub(GenTraceExec)
      copy(OutEnvMO_Resu,"non")
      EXITPROC
   }
copy(OutEnvMO_Resu,"oui")
ENDPROC
