//Rechercher le libelle
while((_wkey!="undefined")&&(wfound=="0"))
   {
      //Recuperer la cle acces
      itread(_wkey,TabAdrMailFaxSmsKey,"1",_varKey)
      gosub(GenGetErreur)
      if(OutGetErreur_Erreur!="")
         {
