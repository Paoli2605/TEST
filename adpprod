PROC(GSCopieFichier)
//****************************************************************
//                      COPIE DE FICHIER
//****************************************************************
//
// GSCopieFichier              IN  : InCopieFichier_Source
//                                    InCopieFichier_Cible
//                              OUT : OutCopieFichier_Resu
//
//----------------------------------------------------------------
//
//init du statut de la proc=
copy(OutCopieFichier_Resu,"non")
//
//On vérifie la présence du fichier source
copy(InPresenceFichier_Fichier,InCopieFichier_Source)
gosub(GSPresenceFichier)
if(OutPresenceFichier_Resu="non")
   {
      copy(InTraceExec_TypeMessage,"W")
      copy(InTraceExec_Message,"GenCopieFichier. Problème de localisation du fichier "InCopieFichier_Source)
      gosub(GenTraceExec)
      copy(OutCopieFichier_Resu,"non")
      EXITPROC
   }
//
//Si le fichier est present dans le repertoire de destination
//on l'efface
copy(InPresenceFichier_Fichier,InCopieFichier_Cible)
gosub(GSPresenceFichier)
if(OutPresenceFichier_Resu="oui")
   {
      // Le fichier existe en sortie, on l'efface
      copy(OutEffaceFichier_Fichier,InCopieFichier_Cible)
      gosub(GSEffaceFichier)
   }
//
//On fait la copie
copy(pyGSFile_Copy_InSrcFile,InCopieFichier_Source)
copy(pyGSFile_Copy_InDstFile,InCopieFichier_Cible)
call(pyGSFile_Copy_return,switchmodule,"pyGSFile_Copy",pyDeliveryOutils)
copy(LocCopieFichier_Resu,pyGSFile_Copy_Resu)
if(LocCopieFichier_Resu!="KO")
   {
      //On teste la présence du fichier dans le repertoire de destination
      copy(InPresenceFichier_Fichier,InCopieFichier_Cible)
      gosub(GSPresenceFichier)
      if(OutPresenceFichier_Resu="non")
         {
            // Fichier cible pas présent => Erreur
            copy(InTraceExec_TypeMessage,"W")
            copy(InTraceExec_Message,"GSCopieFichier. Problème de copie du fichier "InCopieFichier_Source" en "InCopieFichier_Cible)
            gosub(GenTraceExec)
            copy(OutCopieFichier_Resu,"non")
            EXITPROC
         }
   }
else
   {
      copy(InTraceExec_TypeMessage,"W")
      copy(InTraceExec_Message,"GSCopieFichier. Problème de copie du fichier "InCopieFichier_Source" en "InCopieFichier_Cible)
      gosub(GenTraceExec)
      copy(OutCopieFichier_Resu,"non")
      EXITPROC
   }
//
// Fin correcte de la procedure
copy(InTraceExec_TypeMessage,"I")
copy(InTraceExec_Message,"GSCopieFichier. Copie du fichier "InCopieFichier_Source" en "InCopieFichier_Cible" terminée")
gosub(GenTraceExec)
//
copy(OutCopieFichier_Resu,"oui")
ENDPROC
